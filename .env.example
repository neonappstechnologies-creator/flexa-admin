# ── The panel's own front door ───────────────────────────────────────────────
# What a person types to get in. One shared password; there is no user model
# here, and the audience is us.
#
# Unset = the panel refuses everyone rather than opening to anyone — `OpsGuard`'s
# own "closed unless configured" rule, restated on this side.
ADMIN_PASSWORD=""

# Signs the session cookie. At least 32 characters, and NOT the password.
#   openssl rand -base64 48
ADMIN_SESSION_SECRET=""

# ── The API this panel drives ────────────────────────────────────────────────
# Include the /v1 prefix.
#   production   https://api.flexa.beauty/v1
#   local API    http://localhost:3001/v1
FLEXA_API_BASE_URL="https://api.flexa.beauty/v1"

# The API's own OPS_SECRET, verbatim — the same string that is in `apps/api/.env`
# on the box. It authorises /v1/internal/*, so it can switch a clinic off.
#
# It NEVER reaches a browser: every call carrying it is made by this app's
# server. Do not prefix it — or anything else here — with NEXT_PUBLIC_.
OPS_SECRET=""
